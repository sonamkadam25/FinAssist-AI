    {
      "name": "Transaction APIs",
      "item": [
        {
          "name": "Create transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"EXPENSE\",\n  \"amount\": 42.75,\n  \"category\": \"FOOD\",\n  \"merchant\": \"Harbor Cafe\",\n  \"description\": \"Lunch\",\n  \"transactionDate\": \"2026-10-24T12:30:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions"
            }
          }
        },
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions"
            }
          }
        },
        {
          "name": "Filter transactions - amount and status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions?minAmount=100&maxAmount=5000&status=COMPLETED"
            }
          }
        },
        {
          "name": "Filter transactions - type and category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions?transactionType=EXPENSE&category=FOOD"
            }
          }
        },
        {
          "name": "Filter transactions - date range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions?startDate=2026-10-01T00:00:00&endDate=2026-10-27T23:59:59"
            }
          }
        },
        {
          "name": "Get transaction by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}"
            }
          }
        },
        {
          "name": "Update transaction",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"EXPENSE\",\n  \"amount\": 48.25,\n  \"category\": \"FOOD\",\n  \"merchant\": \"Harbor Cafe\",\n  \"description\": \"Updated lunch total\",\n  \"transactionDate\": \"2026-10-24T12:30:00\",\n  \"status\": \"COMPLETED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}"
            }
          }
        },
        {
          "name": "Delete transaction",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}"
            }
          }
        },
        {
          "name": "Summary - all transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/summary"
            }
          }
        },
        {
          "name": "Summary - inclusive date range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/summary?startDate=2026-10-01T00:00:00&endDate=2026-10-27T23:59:59"
            }
          }
        },
        {
          "name": "Summary - invalid date range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/summary?startDate=2026-10-28T00:00:00&endDate=2026-10-27T23:59:59"
            }
          }
        }
      ]
    }
